root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.swift]
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json,xcconfig}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 4

# Dictionary fixtures are byte-exact. An editor that trims or adds a newline
# here breaks the encoding and boundary tests.
[*.{dsl,u8}]
charset = unset
trim_trailing_whitespace = false
insert_final_newline = false

[*.dsl.txt]
trim_trailing_whitespace = false
insert_final_newline = false
